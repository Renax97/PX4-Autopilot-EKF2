<?xml version="1.0"?>
<sdf version="1.6">
  <model name="trellis">
    <static>true</static> <!-- Cambia in true se vuoi che sia immobile -->
    <link name="link">
      <inertial>
  <mass>0.5</mass> <!-- Massa aumentata per stabilità -->
  <inertia>
    <ixx>0.2</ixx> <!-- Aggiornare i valori in base alle dimensioni -->
    <ixy>0</ixy>
    <ixz>0</ixz>
    <iyy>0.2</iyy>
    <iyz>0</iyz>
    <izz>0.4</izz>
  </inertia>
</inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://trellis/meshes/trellis.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu> <!-- Attrito statico -->
              <mu2>1.0</mu2> <!-- Attrito dinamico -->
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
          </bounce>
          <contact>
            <ode/>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://trellis/meshes/trellis.stl</uri>
          </mesh>
        </geometry>
        <material> <!-- Colore soft giallo -->
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0 0 0 0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>

