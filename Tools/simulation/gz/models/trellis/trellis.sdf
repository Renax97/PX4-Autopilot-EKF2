<?xml version="1.0"?>
<sdf version="1.6">
  <model name="trellis">
    <static>true</static> <!-- Cambia in true se vuoi che sia immobile -->
    <link name="link">
      <inertial>
  <mass>100.0</mass> <!-- Massa aumentata per stabilità -->
  <inertia>
    <ixx>469.27</ixx> <!-- Aggiornare i valori in base alle dimensioni -->
    <ixy>0</ixy>
    <ixz>0</ixz>
    <iyy>469.27</iyy>
    <iyz>0</iyz>
    <izz>0.04</izz>
  </inertia>
</inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://trellis/meshes/trellis.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu> <!-- Attrito statico -->
              <mu2>0.4</mu2> <!-- Attrito dinamico -->
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.05</restitution_coefficient>
          </bounce>
          <contact>
 	 <ode>
    <soft_cfm>1e-5</soft_cfm>
    <soft_erp>0.2</soft_erp>
    <kp>1000.0</kp> <!-- High stiffness -->
    <kd>100.0</kd>     <!-- Increased damping for stability -->
    <max_vel>0.1</max_vel>
    <min_depth>0.001</min_depth>
  </ode>
</contact>

        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://trellis/meshes/trellis.stl</uri>
          </mesh>
        </geometry>
        <material> <!-- Colore soft giallo -->
         <ambient>0.8 0.8 0.8 1</ambient>
<diffuse>0.8 0.8 0.8 1</diffuse>
<specular>0.2 0.2 0.2 1</specular>
<emissive>0 0 0 1</emissive>

        </material>
      </visual>
    </link>
  </model>
</sdf>

