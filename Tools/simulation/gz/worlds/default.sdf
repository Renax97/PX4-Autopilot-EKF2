<sdf version='1.9'>
  <world name='default'>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::AirPressure' filename='gz-sim-air-pressure-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen='false'>
      <plugin name='3D View' filename='GzScene3D'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5984631152222222 0.5984631152222222 0.5984631152222222</ambient_light>
        <background_color>0.8984631152222222 0.8984631152222222 0.8984631152222222</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
      </plugin>
      <plugin name='World control' filename='WorldControl'>
        <gz-gui>
          <title>World control</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>72</property>
          <property type='double' key='width'>121</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='left' target='left'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name='World stats' filename='WorldStats'>
        <gz-gui>
          <title>World stats</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>110</property>
          <property type='double' key='width'>290</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='right' target='right'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name='Entity tree' filename='EntityTree'/>
    </gui>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
   <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim7-apply-link-wrench-system">
   </plugin>

    
    
    
  
  <include>
   <uri>model://PotatoChipChair</uri>
   <pose>14 3 0 0 0 0</pose> 
   </include>

   <include>
   <uri>model://VisitorKidSit</uri>
   <pose>14 3 0 0 0 1.5708</pose> 
   </include>



   <include>
   <uri>https://fuel.gazebosim.org/1.0/abmohit/models/Standing person</uri>
   <pose>10 10 0 0 0 0</pose>
   </include>


    <include>
    <uri>model://trellis</uri>
    <pose>5 5 0.05 0 0 0</pose> 
    </include>
    
    
    
    
  
    
    
   
 <model name="grass_plane_with_mesh">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>250 250</size>
        </plane>
      </geometry>
      <surface>
        <friction>
          <ode/>
        </friction>
        <bounce/>
        <contact/>
      </surface>
    </collision>
    <visual name="grass_visual">
      <pose>0 0 0 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <geometry>
        <mesh>
          <uri>file://grass_plane/meshes/grass_plane.dae</uri>
        </mesh>
      </geometry>
    </visual>
    <pose>0 0 0 0 -0 0</pose>
    <inertial>
      <pose>0 0 0 0 -0 0</pose>
      <mass>1</mass>
      <inertia>
        <ixx>1</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>1</iyy>
        <iyz>0</iyz>
        <izz>1</izz>
      </inertia>
    </inertial>
    <enable_wind>false</enable_wind>
  </link>
  <pose>0 0 0 0 -0 0</pose>
  <self_collide>false</self_collide>
</model>



  <model name="block">
      <static>false</static> <!-- Se true, il blocco è fermo; se false, può muoversi -->
    <pose>5 3 0.5 0 0 0</pose> <!-- Posizione iniziale: (x, y, z) e orientazione (rpy) -->
    <link name="block_link">
  
      <!-- Inerzia del blocco -->
      <inertial>
        <mass>5.0</mass> <!-- Massa del blocco -->
        <inertia>
          <ixx>0.1</ixx> <iyy>0.1</iyy> <izz>0.1</izz>
          <ixy>0.0</ixy> <ixz>0.0</ixz> <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Collisione -->
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 0.2</size> <!-- Dimensioni del blocco: lunghezza, larghezza, altezza -->
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
        </surface>
      </collision>

      <!-- Visualizzazione del blocco -->
      <visual name="visual">
        <geometry>
          <box>
            <size>1 1 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient> <!-- Colore rosso -->
        </material>
      </visual>
    </link>
    </model>
 

    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>




<include>
  <uri>file://cable.sdf</uri>
  <pose>2 0 0 0 0 0</pose>
</include>




  <joint name='segment_end_sphere_to_end_link' type='fixed'>
      <parent>flexible_cable::end_sphere</parent>
      <child>end_link_model::end_link</child>
</joint>




  <model name="static_cylinder">
    <static>true</static> <!-- Rende il cilindro statico -->
    <link name="link">
      <pose>2 0.8 0 0 0 0</pose> <!-- Il cilindro parte dal suolo, con centro a 2m per avere 4m di altezza -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius> <!-- Raggio di 1 metro -->
            <length>4.0</length> <!-- Altezza di 4 metri -->
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>4.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
  </model>





    <model name="end_link_model">
  <static>true</static>
    <link name='end_link'>
     <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.10000000000000001</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name='end_link_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.040000000000000001 0.040000000000000001 0.02</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='end_link_visual'>
        <pose>2 0.8 2 1.57 0 0</pose>
        <geometry>
          <box>
            <size>0.040000000000000001 0.040000000000000001 0.02</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Gray</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <diffuse>1 0 0 1</diffuse>
          <ambient>1 0 0 1</ambient>
        </material>
      </visual>
      <self_collide>true</self_collide>
    </link>
     </model>




  </world>
</sdf>
